{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "qc": "node tools/qc.cjs",
    "shuffle-bank": "node tools/shuffle-bank.mjs --apply",
    "shuffle-bank:check": "node tools/shuffle-bank.mjs --check",
    "manifest": "node tools/gen-topics-manifest.mjs",
    "order:check": "node tools/order-manifest.mjs --check",
    "order:add": "node tools/order-manifest.mjs --add",
    "order:remove": "node tools/order-manifest.mjs --remove",
    "state:update": "node tools/gen-state.mjs",
    "stats:users": "node .project/scripts/fetch-stats.mjs",
    "sync": "node .project/sync.mjs",
    "factory:sync-template": "node .project/scripts/factory-sync-template.mjs",
    "factory:scaffold": "node .project/scripts/factory-scaffold.mjs",
    "spec:run": "node .project/scripts/run-spec.mjs",
    "spec:close": "node .project/scripts/close-spec.mjs",
    "spec:enrich": "node .project/scripts/enrich-spec.mjs",
    "runs:log": "node .project/scripts/runs-log.mjs",
    "sync:check": "node .project/sync.mjs --check && npm run consistency:check",
    "consistency:check": "node .project/scripts/check-consistency.mjs",
    "check:episodic": "node tools/check-episodic.mjs",
    "serve:local": "node tools/local-serve.mjs",
    "serve:local:8080": "node tools/local-serve.mjs --port 8080",
    "dashboard": "start http://localhost:3000/dashboard.html && npx --no-install serve docs/dashboard",
    "cosine:intra": "node tools/cosine.cjs --intra-batch",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:run": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@telegram-apps/sdk": "^3.11.8",
    "@telegram-apps/sdk-react": "^3.3.9",
    "@xenova/transformers": "^2.17.2",
    "lucide-react": "^0.446.0",
    "motion": "^13.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^3.2.7",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jest-axe": "^11.0.0",
    "js-yaml": "4.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^3.2.7"
  }
}
